@model AerolineaVIP.Models.Aeronave

@{
    ViewBag.Title = "Eliminar Aeronave";
}

<h2 class="text-danger">Eliminar Aeronave</h2>

<div class="alert alert-warning">
    <strong>Atención:</strong> ¿Está seguro de que desea eliminar esta aeronave del inventario de la aerolínea? Esta acción solo está permitida para el SuperUsuario.
</div>

<div class="card p-4 shadow-sm" style="max-width: 600px;">
    <h4>Aeronave: @Model.Matricula</h4>
    <hr />
    <dl class="row mb-0">
        <dt class="col-sm-4">Matrícula:</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Matricula)</dd>

        <dt class="col-sm-4">Modelo:</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.ModeloAeronave.Nombre)</dd>

        <dt class="col-sm-4">Estado:</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.EstadoAeronave.Descripcion)</dd>
    </dl>
    <hr />
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <input type="submit" value="Confirmar Eliminación" class="btn btn-danger" />
        @Html.ActionLink("Cancelar y Volver", "Index", null, new { @class = "btn btn-outline-secondary" })
    }
</div>