@model IEnumerable<AerolineaVIP.Models.Vuelo>

@{
    ViewBag.Title = "Programación de vuelos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Vuelos operativos (administración)</h2>

@if (TempData["MensajeAdmin"] != null)
{
    <div class="alert alert-success">@TempData["MensajeAdmin"]</div>
}
@if (TempData["ErrorAdmin"] != null)
{
    <div class="alert alert-warning">@TempData["ErrorAdmin"]</div>
}

<p>
    @Html.ActionLink("Volver a programación", "Programacion", "Vuelo", null, new { @class = "btn btn-primary" })
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FechaOperacion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Aeronave.Matricula)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EstadoVuelo.Descripcion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Frecuencia.FrecuenciaId)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.FechaOperacion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Aeronave.Matricula)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoVuelo.Descripcion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Frecuencia.FrecuenciaId)
        </td>
        <td>
            @Html.ActionLink("Editar estado / aeronave", "Edit", new { id=item.VueloId }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.VueloId })
        </td>
    </tr>
}

</table>
