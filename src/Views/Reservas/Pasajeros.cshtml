@model AerolineaVIP.Models.RegistroPasajerosViewModel
@{
    ViewBag.Title = "Datos de Pasajeros";
    var vuelo = Model.Vuelo;
    var tiposDoc = ViewBag.TiposDocumento as IEnumerable<System.Web.Mvc.SelectListItem>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="badge bg-dark mb-1">PANTALLA 09</span>
        <h2 class="mb-0">Registro de Pasajeros por Asiento</h2>
        <p class="text-muted mb-0">Vuelo <strong>@vuelo.CodigoVuelo</strong>: @vuelo.CiudadOrigen (@vuelo.Origen) &rarr; @vuelo.CiudadDestino (@vuelo.Destino) · @vuelo.FechaOperacion.ToString("dd/MM/yyyy")</p>
    </div>
    @Html.ActionLink("← Cambiar asientos", "SeleccionAsiento", "Reservas", new { vueloId = vuelo.VueloId, pasajeros = Model.Pasajeros.Count }, new { @class = "btn btn-outline-secondary" })
</div>

@if (TempData["ErrorAsientos"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorAsientos"]</div>
}

@using (Html.BeginForm("GuardarReserva", "Reservas", FormMethod.Post, new { data_validate_passengers = "true" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.VueloId)
    if (!ViewData.ModelState.IsValid)
    {
        @Html.ValidationSummary(false, "Corrija los campos marcados.", new { @class = "alert alert-danger" })
    }

    for (int i = 0; i < Model.Pasajeros.Count; i++)
    {
        var pasajero = Model.Pasajeros[i];

        <div class="card p-3 shadow-sm mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Pasajero @(i + 1) — Asiento <span class="badge bg-success">@pasajero.CodigoAsiento</span> (#@pasajero.NumeroAsiento · @pasajero.Ubicacion)</h5>
                <span class="fw-bold text-primary">Tarifa: @string.Format("{0:C2}", vuelo.TarifaReferencial)</span>
            </div>
            @Html.HiddenFor(m => m.Pasajeros[i].NumeroAsiento)
            <hr />

            <div class="row g-3">
                <div class="col-md-3">
                    @Html.LabelFor(m => m.Pasajeros[i].TipoDocumento, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.Pasajeros[i].TipoDocumento, tiposDoc, "Seleccione...", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.Pasajeros[i].TipoDocumento, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.Pasajeros[i].NumeroDocumento, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Pasajeros[i].NumeroDocumento, new { @class = "form-control", placeholder = "Ej. 1712345678" })
                    @Html.ValidationMessageFor(m => m.Pasajeros[i].NumeroDocumento, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.Pasajeros[i].Nombres, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Pasajeros[i].Nombres, new { @class = "form-control", placeholder = "Nombres completos" })
                    @Html.ValidationMessageFor(m => m.Pasajeros[i].Nombres, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.Pasajeros[i].Apellidos, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Pasajeros[i].Apellidos, new { @class = "form-control", placeholder = "Apellidos completos" })
                    @Html.ValidationMessageFor(m => m.Pasajeros[i].Apellidos, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    @Html.LabelFor(m => m.Pasajeros[i].FechaNacimiento, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Pasajeros[i].FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", max = DateTime.Today.ToString("yyyy-MM-dd") })
                    @Html.ValidationMessageFor(m => m.Pasajeros[i].FechaNacimiento, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    @Html.LabelFor(m => m.Pasajeros[i].Correo, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Pasajeros[i].Correo, new { @class = "form-control", type = "email", placeholder = "pasajero@correo.com" })
                    @Html.ValidationMessageFor(m => m.Pasajeros[i].Correo, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    @Html.LabelFor(m => m.Pasajeros[i].Telefono, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Pasajeros[i].Telefono, new { @class = "form-control", placeholder = "Ej. 0991234567" })
                    @Html.ValidationMessageFor(m => m.Pasajeros[i].Telefono, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    }

    <div class="card p-3 shadow-sm d-flex flex-row justify-content-between align-items-center">
        <div>
            <span class="text-muted">Total estimado (@Model.Pasajeros.Count pasajero(s)):</span>
            <strong class="fs-4 ms-2">@string.Format("{0:C2}", vuelo.TarifaReferencial * Model.Pasajeros.Count)</strong>
        </div>
        <button type="submit" class="btn btn-vip btn-lg">Confirmar Reserva &rarr;</button>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
