@{
    ViewBag.Title = "Recuperación de contraseña";
}

<main aria-labelledby="title">
    <div class="card-aerolinea">
        <h2 id="title">@ViewBag.Title</h2>
        <hr />
        <p>
            Si la cuenta existe en nuestros registros, recibirá las instrucciones para restablecer su contraseña en el correo electrónico registrado.
        </p>
        <p class="mt-3">
            @Html.ActionLink("Volver a Iniciar sesión", "Login", "Account", null, new { @class = "btn btn-navy" })
        </p>
    </div>
</main>