@model AerolineaVIP.Models.HomeViewModel
@{
    ViewBag.Title = "Inicio";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

<main>
    <section class="vip-hero">
        <h1>Vuela a tu próximo destino</h1>
        <p>Viajes privados con atención personalizada.</p>
    </section>

    <section class="vip-buscador" aria-labelledby="tituloBuscador">
        <h2 id="tituloBuscador" class="h4 mb-3">Encuentra tu vuelo</h2>

        <form id="formBuscar" method="get" action="@Url.Action("Resultados", "Vuelos")" novalidate>
            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="origen" class="form-label">Origen *</label>
                    @Html.DropDownList("origen", Model.Origenes, new { @class = "form-select", required = "required", aria_describedby = "errOrigen" })
                    <div id="errOrigen" class="vip-error" role="alert"></div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label for="destino" class="form-label">Destino *</label>
                    @Html.DropDownList("destino", Model.Destinos, "Seleccionar destino", new { @class = "form-select", required = "required", aria_describedby = "errDestino" })
                    <div id="errDestino" class="vip-error" role="alert"></div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label for="fecha" class="form-label">Fecha de salida *</label>
                    <input type="date" id="fecha" name="fecha" class="form-control" min="@hoy" required aria-describedby="errFecha" />
                    <div id="errFecha" class="vip-error" role="alert"></div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label for="pasajeros" class="form-label">Pasajeros *</label>
                    <input type="number" id="pasajeros" name="pasajeros" class="form-control" min="1" max="7" value="@Model.Pasajeros" required aria-describedby="ayudaPasajeros errPasajeros" />
                    <div id="ayudaPasajeros" class="vip-ayuda">De 1 a 7 (capacidad máxima por vuelo)</div>
                    <div id="errPasajeros" class="vip-error" role="alert"></div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" id="btnBuscar" class="btn btn-vip btn-lg">Buscar vuelos</button>
            </div>
        </form>

        <p class="vip-aviso">Horarios sujetos a la programación establecida y disponibilidad real.</p>
    </section>

    <section class="py-5" aria-labelledby="tituloDestinos">
        <h2 id="tituloDestinos" class="h3 mb-4">Destinos</h2>
        <div class="row g-4">
            <div class="col-12 col-md-4">
                <article class="vip-destino">
                    <h3 class="h5">Guayaquil</h3>
                    <p class="mb-0">Martes, jueves y sábado</p>
                </article>
            </div>
            <div class="col-12 col-md-4">
                <article class="vip-destino">
                    <h3 class="h5">Manta</h3>
                    <p class="mb-0">Lunes, miércoles y viernes</p>
                </article>
            </div>
            <div class="col-12 col-md-4">
                <article class="vip-destino">
                    <h3 class="h5">Galápagos (escala en Guayaquil)</h3>
                    <p class="mb-0">Domingo</p>
                </article>
            </div>
        </div>
    </section>
</main>

@section scripts {
    <script>
        $(function () {
            var $origen = $('#origen');
            var $destino = $('#destino');
            var $fecha = $('#fecha');
            var $pasajeros = $('#pasajeros');
            var $boton = $('#btnBuscar');
            var $form = $('#formBuscar');
            var urlDestinos = '@Url.Action("Destinos", "Home")';

            function marcarError($campo, idError, mensaje) {
                $('#' + idError).text(mensaje);
                $campo.addClass('is-invalid').attr('aria-invalid', 'true');
            }

            function limpiarErrores() {
                $('.vip-error').text('');
                $form.find('.is-invalid').removeClass('is-invalid').removeAttr('aria-invalid');
            }

            function cargarDestinos() {
                $destino.prop('disabled', true);
                $.getJSON(urlDestinos, { origen: $origen.val() })
                    .done(function (datos) {
                        $destino.empty();
                        if (datos.length === 0) {
                            $destino.append($('<option>').val('').text('Sin destinos disponibles'));
                            $boton.prop('disabled', true);
                            return;
                        }
                        $destino.append($('<option>').val('').text('Seleccionar destino'));
                        $.each(datos, function (i, d) {
                            $destino.append($('<option>').val(d.codigo).text(d.texto));
                        });
                        $boton.prop('disabled', false);
                        $destino.prop('disabled', false);
                    })
                    .fail(function () {
                        $destino.prop('disabled', false);
                        marcarError($destino, 'errDestino', 'No se pudieron cargar los destinos. Intente nuevamente.');
                    });
            }

            $origen.on('change', function () {
                limpiarErrores();
                cargarDestinos();
            });

            $form.on('submit', function (e) {
                limpiarErrores();
                var primero = null;

                function falla($campo, idError, mensaje) {
                    marcarError($campo, idError, mensaje);
                    if (!primero) { primero = $campo; }
                }

                if (!$origen.val()) {
                    falla($origen, 'errOrigen', 'Seleccione el origen.');
                }

                if (!$destino.val()) {
                    falla($destino, 'errDestino', 'Seleccione el destino.');
                } else if ($destino.val() === $origen.val()) {
                    falla($destino, 'errDestino', 'El origen y el destino deben ser distintos.');
                }

                var fecha = $fecha.val();
                if (!fecha) {
                    falla($fecha, 'errFecha', 'Indique la fecha de salida.');
                } else if (fecha < $fecha.attr('min')) {
                    falla($fecha, 'errFecha', 'La fecha no puede ser anterior a hoy.');
                }

                var n = parseInt($pasajeros.val(), 10);
                if (isNaN(n) || n < 1 || n > 7) {
                    falla($pasajeros, 'errPasajeros', 'La cantidad de pasajeros debe estar entre 1 y 7.');
                }

                if (primero) {
                    e.preventDefault();
                    primero.focus();
                    return;
                }

                $boton.prop('disabled', true).text('Buscando…');
            });

            $(window).on('pageshow', function () {
                $boton.text('Buscar vuelos').prop('disabled', $destino.find('option').length <= 1);
            });
        });
    </script>
}