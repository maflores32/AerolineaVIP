@model AerolineaVIP.Models.Frecuencia

@{
    ViewBag.Title = "Editar frecuencia";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge bg-dark mb-1">CATÁLOGO DE OPERACIÓN</span>
        <h2 class="mb-1">Editar frecuencia</h2>
        <p class="text-muted mb-0">Actualice el día, la ruta o el horario de operación.</p>
    </div>
    @Html.ActionLink("← Volver a frecuencias", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm(null, null, FormMethod.Post, new { data_validate_frequency = "true" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            @Html.HiddenFor(m => m.FrecuenciaId)
            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.RutaId, new { @class = "form-label fw-semibold" })
                    @Html.DropDownListFor(m => m.RutaId, null, "Seleccione una ruta...", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.RutaId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.DiaSemana, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.DiaSemana, new { @class = "form-control", min = "1", max = "7", step = "1", type = "number", required = "required" })
                    @Html.ValidationMessageFor(m => m.DiaSemana, "", new { @class = "text-danger" })
                    <div class="form-text">Indique un valor del 1 al 7.</div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.HoraSalida, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.HoraSalida, "{0:hh\\:mm}", new { @class = "form-control", type = "time", required = "required" })
                    @Html.ValidationMessageFor(m => m.HoraSalida, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.HoraLlegada, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.HoraLlegada, "{0:hh\\:mm}", new { @class = "form-control", type = "time", required = "required" })
                    @Html.ValidationMessageFor(m => m.HoraLlegada, "", new { @class = "text-danger" })
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.Activa, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.Activa, new { @class = "form-check-label" })
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-vip">Guardar cambios</button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}