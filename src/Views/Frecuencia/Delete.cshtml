@model AerolineaVIP.Models.Frecuencia

@{
    ViewBag.Title = "Eliminar frecuencia";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge bg-dark mb-1">CATÁLOGO DE OPERACIÓN</span>
        <h2 class="mb-1">Eliminar frecuencia</h2>
        <p class="text-muted mb-0">Revise la frecuencia antes de confirmar la eliminación.</p>
    </div>
    @Html.ActionLink("← Volver a frecuencias", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>

<div class="alert alert-warning" role="alert">Una frecuencia con vuelos generados no se puede borrar; puede desactivarla desde Editar.</div>
<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ruta</dt><dd class="col-sm-9">@Model.Ruta.Aeropuerto.CodigoIATA &rarr; @Model.Ruta.Aeropuerto1.CodigoIATA</dd>
            <dt class="col-sm-3">Día de operación</dt><dd class="col-sm-9">@System.Globalization.CultureInfo.GetCultureInfo("es-ES").DateTimeFormat.GetDayName((DayOfWeek)(Model.DiaSemana % 7))</dd>
            <dt class="col-sm-3">Hora de salida</dt><dd class="col-sm-9">@Model.HoraSalida.ToString(@"hh\:mm")</dd>
            <dt class="col-sm-3">Hora de llegada</dt><dd class="col-sm-9">@Model.HoraLlegada.ToString(@"hh\:mm")</dd>
            <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.Activa ? "Activa" : "Inactiva")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">Eliminar frecuencia</button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
        }
    </div>
</div>