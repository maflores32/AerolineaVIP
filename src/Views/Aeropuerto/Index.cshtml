@model IEnumerable<AerolineaVIP.Models.Aeropuerto>

@{
    ViewBag.Title = "Aeropuertos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge bg-dark mb-1">CATÁLOGO DE OPERACIÓN</span>
        <h2 class="mb-1">Aeropuertos</h2>
        <p class="text-muted mb-0">Administre aeropuertos y sus códigos IATA para configurar rutas.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @Html.ActionLink("← Panel de administración", "Index", "Admin", null, new { @class = "btn btn-outline-secondary" })
        @Html.ActionLink("Crear aeropuerto", "Create", null, new { @class = "btn btn-vip" })
    </div>
</div>

<div class="mb-3 d-flex flex-wrap gap-2" aria-label="Flujo de configuración">
    @Html.ActionLink("1. Aeropuertos", "Index", "Aeropuerto", null, new { @class = "btn btn-sm btn-vip", aria_current = "page" })
    @Html.ActionLink("2. Rutas", "Index", "Ruta", null, new { @class = "btn btn-sm btn-outline-secondary" })
    @Html.ActionLink("3. Frecuencias", "Index", "Frecuencia", null, new { @class = "btn btn-sm btn-outline-secondary" })
    @Html.ActionLink("4. Programación", "Programacion", "Vuelo", null, new { @class = "btn btn-sm btn-outline-secondary" })
</div>

@if (TempData["MensajeAdmin"] != null)
{
    <div class="alert alert-success" role="status">@TempData["MensajeAdmin"]</div>
}
@if (TempData["ErrorAdmin"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["ErrorAdmin"]</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h3 class="h5 mb-0">Aeropuertos registrados</h3>
        <span class="badge bg-secondary">@(Model == null ? 0 : Model.Count())</span>
    </div>
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center text-muted p-4">
                <p class="mb-2">Todavía no hay aeropuertos configurados.</p>
                @Html.ActionLink("Crear el primer aeropuerto", "Create", null, new { @class = "btn btn-outline-primary" })
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Código IATA</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Localidad</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-dark">@item.CodigoIATA</span></td>
                                <td>@item.Nombre</td>
                                <td>@item.Localidad</td>
                                <td><span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink("Detalles", "Details", new { id = item.AeropuertoId }, new { @class = "btn btn-sm btn-outline-info" })
                                    @Html.ActionLink("Editar", "Edit", new { id = item.AeropuertoId }, new { @class = "btn btn-sm btn-outline-primary" })
                                    @if (User.IsInRole("SuperUsuario"))
                                    {
                                        @Html.ActionLink("Eliminar", "Delete", new { id = item.AeropuertoId }, new { @class = "btn btn-sm btn-outline-danger" })
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>