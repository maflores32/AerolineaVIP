@model IEnumerable<AerolineaVIP.Models.vw_VueloDetalle>
@{
    ViewBag.Title = "Programación de Vuelos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="badge bg-dark mb-1">PANTALLA 18</span>
        <h2 class="mb-0">Programación operativa de vuelos</h2>
        <p class="text-muted mb-0">Módulo exclusivo de administración para generar operaciones y gestionar estados; el buscador público está en «Buscar vuelos».</p>
    </div>
    <div class="d-flex gap-2">
        @Html.ActionLink("Listado CRUD", "Index", "Vuelo", null, new { @class = "btn btn-outline-primary" })
        @Html.ActionLink("← Volver al Panel", "Index", "Admin", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

@if (TempData["MensajeAdmin"] != null)
{
    <div class="alert alert-success">@TempData["MensajeAdmin"]</div>
}
@if (TempData["ErrorAdmin"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorAdmin"]</div>
}

<div class="card p-3 shadow-sm mb-4 border-start border-4 border-primary">
    <h5 class="card-title text-primary mb-2">Generar vuelos desde las frecuencias activas</h5>
    <p class="small text-muted mb-3">Crea las operaciones para el rango indicado usando las rutas, horarios y días configurados. El proceso evita duplicar vuelos ya generados.</p>

    @using (Html.BeginForm("GenerarVuelos", "Vuelo", FormMethod.Post, new { @class = "row g-3 align-items-end" }))
    {
        @Html.AntiForgeryToken()
        <div class="col-md-4">
            <label class="form-label fw-bold">Fecha de inicio</label>
            <input type="date" name="fechaInicio" min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddDays(365).ToString("yyyy-MM-dd")" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Fecha de fin</label>
            <input type="date" name="fechaFin" min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddDays(365).ToString("yyyy-MM-dd")" class="form-control" required value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100" onclick="return confirm('¿Desea generar los vuelos para este rango de fechas?');">
                Generar vuelos
            </button>
        </div>
    }
</div>

<!-- Filtros de búsqueda -->
<div class="card p-3 shadow-sm mb-4">
    @using (Html.BeginForm("Programacion", "Vuelo", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
    {
        <div class="col-md-3">
            <label class="form-label fw-bold">Desde:</label>
            <input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Hasta:</label>
            <input type="date" name="fechaFin" value="@ViewBag.FechaFin" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Estado:</label>
            @Html.DropDownList("estado", (SelectList)ViewBag.Estados, "-- Todos --", new { @class = "form-select" })
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-secondary flex-fill">Filtrar</button>
            @Html.ActionLink("Limpiar", "Programacion", "Vuelo", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>

<!-- Tabla de vuelos -->
<div class="card p-3 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Vuelo ID</th>
                    <th>Código</th>
                    <th>Ruta</th>
                    <th>Fecha Operación</th>
                    <th>Horario</th>
                    <th>Estado</th>
                    <th class="text-center">Cambiar Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string colorBadge = item.EstadoVueloCodigo == "CONFIRMADO" ? "bg-success" :
                                       (item.EstadoVueloCodigo == "PROGRAMADO" ? "bg-primary" :
                                       (item.EstadoVueloCodigo == "CANCELADO" ? "bg-danger" : "bg-secondary"));
                    <tr>
                        <td><strong>#@item.VueloId</strong></td>
                        <td><strong class="text-primary">@item.CodigoVuelo</strong></td>
                        <td>@item.CiudadOrigen (@item.Origen) &rarr; @item.CiudadDestino (@item.Destino)</td>
                        <td>@item.FechaOperacion.ToString("dd/MM/yyyy")</td>
                        <td>@item.HoraSalida.ToString(@"hh\:mm") - @item.HoraLlegada.ToString(@"hh\:mm")</td>
                        <td><span class="badge @colorBadge">@item.EstadoVueloCodigo</span></td>
                        <td class="text-center">
                            @using (Html.BeginForm("CambiarEstadoVuelo", "Vuelo", FormMethod.Post, new { @class = "d-inline-flex gap-1" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="vueloId" value="@item.VueloId" />
                                <select name="nuevoEstado" class="form-select form-select-sm admin-estado-vuelo">
                                    <option value="CONFIRMADO" @(item.EstadoVueloCodigo == "CONFIRMADO" ? "selected" : "")>CONFIRMADO</option>
                                    <option value="PROGRAMADO" @(item.EstadoVueloCodigo == "PROGRAMADO" ? "selected" : "")>PROGRAMADO</option>
                                    <option value="CANCELADO" @(item.EstadoVueloCodigo == "CANCELADO" ? "selected" : "")>CANCELADO</option>
                                    <option value="COMPLETADO" @(item.EstadoVueloCodigo == "COMPLETADO" ? "selected" : "")>COMPLETADO</option>
                                </select>
                                <select name="aeronaveId" class="form-select form-select-sm" aria-label="Asignar aeronave">
                                    <option value="">Mantener aeronave</option>
                                    @foreach (System.Web.Mvc.SelectListItem aeronave in (IEnumerable<System.Web.Mvc.SelectListItem>)ViewBag.Aeronaves)
                                    {
                                        <option value="@aeronave.Value" @(item.AeronaveId.HasValue && item.AeronaveId.Value.ToString() == aeronave.Value ? "selected" : "")>@aeronave.Text</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-dark">Actualizar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>