@model AerolineaVIP.Controllers.AdminDashboardViewModel
@{
    ViewBag.Title = "Panel de Administración";
}

<div class="mb-4">
    <span class="badge bg-dark mb-1">PANTALLA 17</span>
    <h2 class="mb-1">Panel de Administración Operativa</h2>
    <p class="text-muted mb-0">Seleccione el módulo que desea gestionar dentro del sistema de la aerolínea.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg"><div class="card h-100 p-3"><span class="text-muted small">Vuelos de hoy</span><strong class="fs-3">@Model.VuelosHoy</strong></div></div>
    <div class="col-6 col-lg"><div class="card h-100 p-3"><span class="text-muted small">Reservas pendientes</span><strong class="fs-3">@Model.ReservasPendientes</strong></div></div>
    <div class="col-6 col-lg"><div class="card h-100 p-3"><span class="text-muted small">Aeronaves disponibles</span><strong class="fs-3">@Model.AeronavesDisponibles</strong></div></div>
    <div class="col-6 col-lg"><div class="card h-100 p-3"><span class="text-muted small">Rutas activas</span><strong class="fs-3">@Model.RutasActivas</strong></div></div>
    <div class="col-12 col-lg"><div class="card h-100 p-3"><span class="text-muted small">Ingresos del mes (USD)</span><strong class="fs-3">@Model.IngresosMes.ToString("C2")</strong></div></div>
</div>

@if (TempData["MensajeAdmin"] != null)
{
    <div class="alert alert-success">@TempData["MensajeAdmin"]</div>
}

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm border-top border-4 border-primary p-3">
            <h5 class="card-title text-primary">Programación de Vuelos</h5>
            <p class="card-text text-muted small">Generación masiva con Store Procedure (usp_GenerarVuelos), confirmación y cancelación operativa.</p>
            <div class="mt-auto">
                @Html.ActionLink("Gestionar Vuelos →", "Vuelos", "Admin", null, new { @class = "btn btn-outline-primary w-100" })
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm border-top border-4 border-warning p-3">
            <h5 class="card-title text-warning">Flota de Aeronaves</h5>
            <p class="card-text text-muted small">Control de la flota ejecutiva Embraer Phenom 300E (AV-01, AV-02, AV-03) y estados de operatividad.</p>
            <div class="mt-auto">
                @Html.ActionLink("Gestionar Flota →", "Aeronaves", "Admin", null, new { @class = "btn btn-outline-warning text-dark w-100" })
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm border-top border-4 border-success p-3">
            <h5 class="card-title text-success">Usuarios, pasajeros y reservas</h5>
            <p class="card-text text-muted small">Gestione pasajeros, reservas y configuración de rutas y frecuencias antes de generar vuelos.</p>
            <div class="mt-auto">
                @Html.ActionLink("Gestionar rutas y reservas →", "Gestion", "Admin", new { tab = "rutas" }, new { @class = "btn btn-outline-success w-100" })
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm border-top border-4 border-info p-3">
            <h5 class="card-title text-info">Reportes Operativos</h5>
            <p class="card-text text-muted small">Ocupación real de la cabina de 7 asientos, porcentajes de carga por ruta e ingresos totales generados.</p>
            <div class="mt-auto">
                @Html.ActionLink("Ver Reportes →", "Reportes", "Admin", null, new { @class = "btn btn-outline-info text-dark w-100" })
            </div>
        </div>
    </div>
</div>