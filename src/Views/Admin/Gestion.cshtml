@model AerolineaVIP.Controllers.GestionAdminViewModel

@{
    ViewBag.Title = "Gestión de Usuarios, Pasajeros y Reservas";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="badge bg-dark mb-1">PANTALLA 20</span>
        <h2 class="mb-0">Gestión de Operaciones</h2>
        <p class="text-muted mb-0">Administre cuentas, pasajeros, reservas y accesos a los catálogos.</p>
    </div>
    @Html.ActionLink("← Volver al Panel", "Index", "Admin", null, new { @class = "btn btn-outline-secondary" })
</div>

<!-- Pestañas de Navegación (Según Wireframe) -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.TabActivo == "usuarios" ? "active fw-bold" : "")" href="@Url.Action("Gestion", new { tab = "usuarios" })">Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActivo == "pasajeros" ? "active fw-bold" : "")" href="@Url.Action("Gestion", new { tab = "pasajeros" })">Pasajeros</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActivo == "reservas" ? "active fw-bold" : "")" href="@Url.Action("Gestion", new { tab = "reservas" })">Reservas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActivo == "rutas" ? "active fw-bold" : "")" href="@Url.Action("Gestion", new { tab = "rutas" })">Catálogos</a>
    </li>
</ul>

@if (TempData["ErrorAdmin"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorAdmin"]</div>
}
@if (TempData["MensajeAdmin"] != null)
{
    <div class="alert alert-success">@TempData["MensajeAdmin"]</div>
}

@if (Model.TabActivo == "rutas")
{
    <div class="row g-3">
        <div class="col-md-4"><div class="card h-100 p-3"><h5>Aeropuertos</h5><p class="text-muted">Gestione aeropuertos y códigos IATA.</p>@Html.ActionLink("Gestionar aeropuertos", "Index", "Aeropuerto", null, new { @class = "btn btn-outline-primary mt-auto" })</div></div>
        <div class="col-md-4"><div class="card h-100 p-3"><h5>Rutas</h5><p class="text-muted">Configure origen, destino y tarifa.</p>@Html.ActionLink("Gestionar rutas", "Index", "Ruta", null, new { @class = "btn btn-outline-primary mt-auto" })</div></div>
        <div class="col-md-4"><div class="card h-100 p-3"><h5>Frecuencias</h5><p class="text-muted">Defina días y horarios de operación.</p>@Html.ActionLink("Gestionar frecuencias", "Index", "Frecuencia", null, new { @class = "btn btn-outline-primary mt-auto" })</div></div>
    </div>
    <div class="alert alert-info mt-3">Tras configurar rutas y frecuencias, utilice <strong>Programación de vuelos</strong> para generar las operaciones.</div>
}

<!-- Barra de Filtros y Búsqueda (Según Wireframe) -->
@if (Model.TabActivo != "rutas")
{
<div class="card p-3 shadow-sm mb-3">
    @using (Html.BeginForm("Gestion", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
    {
        <input type="hidden" name="tab" value="@Model.TabActivo" />

        <div class="col-md-5">
            <label class="form-label text-muted small mb-1">Buscar (opcional)</label>
            <input type="text" name="buscar" class="form-control" placeholder="usuario, correo..." value="@Model.Buscar" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-dark w-100">Consultar</button>
        </div>
    }
</div>

<!-- Tabla de Resultados (Adaptada a la pestaña activa) -->
<div class="card p-3 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    @if (Model.TabActivo == "usuarios")
                    {
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        if (Model.EsSuperUsuario) { <th>Asignar rol</th> }
                    }
                    else if (Model.TabActivo == "pasajeros")
                    {
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Documento</th>
                        <th>Teléfono</th>
                        <th>Acciones</th>
                    }
                    else if (Model.TabActivo == "reservas")
                    {
                        <th>Código</th>
                        <th>Fecha de Viaje</th>
                        <th>Estado Reserva</th>
                        <th>Estado Compra</th>
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.TabActivo == "usuarios" && Model.Cuentas != null && Model.Cuentas.Any())
                {
                    foreach (var user in Model.Cuentas)
                    {
                        <tr>
                            <td><strong>@user.Nombre</strong></td>
                            <td>@user.Correo</td>
                            <td>@user.Rol</td>
                            <td><span class="badge @(user.Activo ? "bg-success" : "bg-secondary")">@(user.Activo ? "Activa" : "Bloqueada")</span></td>
                            @if (Model.EsSuperUsuario)
                            {
                                <td>
                                    @using (Html.BeginForm("CambiarRol", "Admin", FormMethod.Post, new { @class = "d-flex gap-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="usuarioId" value="@user.Id" />
                                        @Html.DropDownList("rol", (SelectList)ViewBag.RolesDisponibles, user.Rol, new { @class = "form-select form-select-sm", required = "required" })
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
                else if (Model.TabActivo == "usuarios" && Model.Cuentas != null)
                {
                    <tr><td colspan="@(Model.EsSuperUsuario ? 5 : 4)" class="text-center text-muted py-4">No se encontraron cuentas.</td></tr>
                }
                else if (Model.TabActivo == "pasajeros" && Model.Pasajeros != null && Model.Pasajeros.Any())
                {
                    foreach (var p in Model.Pasajeros)
                    {
                        <tr>
                            <td>@p.Nombres</td>
                            <td>@p.Apellidos</td>
                            <td>@p.NumeroDocumento</td>
                            <td>@p.Telefono</td>
                            <td>
                                @Html.ActionLink("Ver reservas / check-in", "Index", "CheckIn", new { pasajero = p.NumeroDocumento }, new { @class = "text-decoration-none" })
                            </td>
                        </tr>
                    }
                }
                else if (Model.TabActivo == "reservas" && Model.Reservas != null && Model.Reservas.Any())
                {
                    foreach (var r in Model.Reservas)
                    {
                        <tr>
                            <td><strong>@r.CodigoReserva</strong></td>
                            <td>@r.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-warning text-dark">@r.EstadoReservaCodigo</span></td>
                            <td><span class="badge bg-secondary">Sin compra</span></td>
                            <td>
                                @Html.ActionLink("Gestionar", "Gestionar", "Reservas", new { id = r.ReservaId }, new { @class = "text-decoration-none" })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No se encontraron registros para los filtros seleccionados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

}
