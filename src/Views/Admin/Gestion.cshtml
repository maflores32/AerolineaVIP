@model AerolineaVIP.Controllers.GestionAdminViewModel

@{
    ViewBag.Title = "Gestión de Usuarios, Pasajeros y Reservas";
}
                else if (Model.TabActivo == "usuarios" && Model.Cuentas != null)
                {
                    <tr><td colspan="@(Model.EsSuperUsuario ? 5 : 4)" class="text-center text-muted py-4">No se encontraron cuentas.</td></tr>
                }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="badge bg-dark mb-1">PANTALLA 20</span>
        <h2 class="mb-0">Gestión de Operaciones</h2>
        <p class="text-muted mb-0">Administre usuarios, pasajeros y reservas del sistema.</p>
    </div>
    @Html.ActionLink("← Volver al Panel", "Index", "Admin", null, new { @class = "btn btn-outline-secondary" })
</div>

<!-- Pestañas de Navegación (Según Wireframe) -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.TabActivo == "usuarios" ? "active fw-bold" : "")" href="@Url.Action("Gestion", new { tab = "usuarios" })">Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActivo == "pasajeros" ? "active fw-bold" : "")" href="@Url.Action("Gestion", new { tab = "pasajeros" })">Pasajeros</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActivo == "reservas" ? "active fw-bold" : "")" href="@Url.Action("Gestion", new { tab = "reservas" })">Reservas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActivo == "rutas" ? "active fw-bold" : "")" href="@Url.Action("Gestion", new { tab = "rutas" })">Rutas y frecuencias</a>
    </li>
</ul>

@if (TempData["ErrorAdmin"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorAdmin"]</div>
}
@if (TempData["MensajeAdmin"] != null)
{
    <div class="alert alert-success">@TempData["MensajeAdmin"]</div>
}

@if (Model.TabActivo == "rutas")
{
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <h5>1. Crear ruta</h5>
                @using (Html.BeginForm("CrearRuta", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Aeropuerto de origen</label>
                        @Html.DropDownList("AeropuertoOrigenId", (SelectList)ViewBag.Aeropuertos, "Seleccione...", new { @class = "form-select", required = "required" })
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Aeropuerto de destino</label>
                        @Html.DropDownList("AeropuertoDestinoId", (SelectList)ViewBag.Aeropuertos, "Seleccione...", new { @class = "form-select", required = "required" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tarifa referencial (USD)</label>
                        <input type="number" name="TarifaReferencial" min="0.01" max="10000" step="0.01" class="form-control" required />
                    </div>
                    <button class="btn btn-primary" type="submit">Crear ruta</button>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <h5>2. Añadir frecuencia</h5>
                @using (Html.BeginForm("CrearFrecuencia", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Ruta activa</label>
                        @Html.DropDownList("RutaId", (IEnumerable<System.Web.Mvc.SelectListItem>)ViewBag.RutasActivas, "Seleccione...", new { @class = "form-select", required = "required" })
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Día de operación</label>
                        <select name="DiaSemana" class="form-select" required>
                            <option value="">Seleccione...</option>
                            <option value="1">Lunes</option><option value="2">Martes</option>
                            <option value="3">Miércoles</option><option value="4">Jueves</option>
                            <option value="5">Viernes</option><option value="6">Sábado</option><option value="7">Domingo</option>
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Salida</label>
                            <input type="time" name="HoraSalida" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="form-label">Llegada</label>
                            <input type="time" name="HoraLlegada" class="form-control" required />
                        </div>
                    </div>
                    <button class="btn btn-primary" type="submit">Guardar frecuencia</button>
                }
            </div>
        </div>
    </div>

    <div class="card p-3 mb-4">
        <h5>Rutas existentes</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr><th>Origen</th><th>Destino</th><th>Tarifa USD</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                    @foreach (var ruta in Model.Rutas)
                    {
                        <tr>
                            <td>@ruta.Aeropuerto.CodigoIATA · @ruta.Aeropuerto.Localidad</td>
                            <td>@ruta.Aeropuerto1.CodigoIATA · @ruta.Aeropuerto1.Localidad</td>
                            <td>
                                @using (Html.BeginForm("ActualizarTarifaRuta", "Admin", FormMethod.Post, new { @class = "d-flex gap-1" }))
                                {
                                    @Html.AntiForgeryToken()<input type="hidden" name="rutaId" value="@ruta.RutaId" />
                                    <input type="number" name="tarifaReferencial" value="@ruta.TarifaReferencial" min="0.01" max="10000" step="0.01" class="form-control form-control-sm" />
                                    <button class="btn btn-sm btn-outline-primary" type="submit">Guardar</button>
                                }
                            </td>
                            <td>@(ruta.Activa ? "Activa" : "Inactiva")</td>
                            <td>
                                @using (Html.BeginForm("CambiarEstadoRuta", "Admin", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()<input type="hidden" name="rutaId" value="@ruta.RutaId" />
                                    <input type="hidden" name="activa" value="@(!ruta.Activa)" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">@(ruta.Activa ? "Desactivar" : "Activar")</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card p-3">
        <h5>Frecuencias existentes</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr><th>Ruta</th><th>Día</th><th>Salida</th><th>Llegada</th><th>Estado</th><th>Acción</th></tr></thead>
                <tbody>
                    @foreach (var frecuencia in Model.Frecuencias)
                    {
                        <tr>
                            <td>@frecuencia.Ruta.Aeropuerto.CodigoIATA → @frecuencia.Ruta.Aeropuerto1.CodigoIATA</td>
                            <td>@frecuencia.DiaSemana</td>
                            <td>@frecuencia.HoraSalida.ToString(@"hh\:mm")</td>
                            <td>@frecuencia.HoraLlegada.ToString(@"hh\:mm")</td>
                            <td>@(frecuencia.Activa ? "Activa" : "Inactiva")</td>
                            <td>
                                @using (Html.BeginForm("CambiarEstadoFrecuencia", "Admin", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()<input type="hidden" name="frecuenciaId" value="@frecuencia.FrecuenciaId" />
                                    <input type="hidden" name="activa" value="@(!frecuencia.Activa)" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">@(frecuencia.Activa ? "Desactivar" : "Activar")</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small text-muted mb-0">Después de crear o activar rutas y frecuencias, genere los vuelos desde Programación de Vuelos.</p>
    </div>
}

<!-- Barra de Filtros y Búsqueda (Según Wireframe) -->
@if (Model.TabActivo != "rutas")
{
<div class="card p-3 shadow-sm mb-3">
    @using (Html.BeginForm("Gestion", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
    {
        <input type="hidden" name="tab" value="@Model.TabActivo" />

        <div class="col-md-5">
            <label class="form-label text-muted small mb-1">Buscar (opcional)</label>
            <input type="text" name="buscar" class="form-control" placeholder="usuario, correo..." value="@Model.Buscar" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-dark w-100">Consultar</button>
        </div>
    }
</div>

<!-- Tabla de Resultados (Adaptada a la pestaña activa) -->
<div class="card p-3 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    @if (Model.TabActivo == "usuarios")
                    {
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        @if (Model.EsSuperUsuario) { <th>Asignar rol</th> }
                    }
                    else if (Model.TabActivo == "pasajeros")
                    {
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Documento</th>
                        <th>Teléfono</th>
                        <th>Acciones</th>
                    }
                    else if (Model.TabActivo == "reservas")
                    {
                        <th>Código</th>
                        <th>Fecha de Viaje</th>
                        <th>Estado Reserva</th>
                        <th>Estado Compra</th>
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.TabActivo == "usuarios" && Model.Cuentas != null && Model.Cuentas.Any())
                {
                    foreach (var user in Model.Cuentas)
                    {
                        <tr>
                            <td><strong>@user.Nombre</strong></td>
                            <td>@user.Correo</td>
                            <td>@user.Rol</td>
                            <td><span class="badge @(user.Activo ? "bg-success" : "bg-secondary")">@(user.Activo ? "Activa" : "Bloqueada")</span></td>
                            @if (Model.EsSuperUsuario)
                            {
                                <td>
                                    @using (Html.BeginForm("CambiarRol", "Admin", FormMethod.Post, new { @class = "d-flex gap-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="usuarioId" value="@user.Id" />
                                        @Html.DropDownList("rol", (SelectList)ViewBag.RolesDisponibles, user.Rol, new { @class = "form-select form-select-sm", required = "required" })
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
                else if (Model.TabActivo == "usuarios" && Model.Cuentas != null)
                {
                    <tr><td colspan="@(Model.EsSuperUsuario ? 5 : 4)" class="text-center text-muted py-4">No se encontraron cuentas.</td></tr>
                }
                else if (Model.TabActivo == "pasajeros" && Model.Pasajeros != null && Model.Pasajeros.Any())
                {
                    foreach (var p in Model.Pasajeros)
                    {
                        <tr>
                            <td>@p.Nombres</td>
                            <td>@p.Apellidos</td>
                            <td>@p.NumeroDocumento</td>
                            <td>@p.Telefono</td>
                            <td>
                                @Html.ActionLink("Ver reservas / check-in", "Index", "CheckIn", new { pasajero = p.NumeroDocumento }, new { @class = "text-decoration-none" })
                            </td>
                        </tr>
                    }
                }
                else if (Model.TabActivo == "reservas" && Model.Reservas != null && Model.Reservas.Any())
                {
                    foreach (var r in Model.Reservas)
                    {
                        <tr>
                            <td><strong>@r.CodigoReserva</strong></td>
                            <td>@r.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-warning text-dark">@r.EstadoReservaCodigo</span></td>
                            <td><span class="badge bg-secondary">Sin compra</span></td>
                            <td>
                                @Html.ActionLink("Gestionar", "Gestionar", "Reservas", new { id = r.ReservaId }, new { @class = "text-decoration-none" })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No se encontraron registros para los filtros seleccionados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

}
