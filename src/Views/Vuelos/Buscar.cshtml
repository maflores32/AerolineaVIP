@{
    ViewBag.Title = "Buscar vuelos";
}

<div class="card-aerolinea mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <span class="badge bg-dark mb-1">PANTALLA 05</span>
            <h2 class="mb-1">Buscar vuelos disponibles</h2>
            <p class="text-muted mb-0">Busque vuelos para reservar. Este módulo es público y distinto de la programación operativa de administración.</p>
        </div>

    </div>
    <hr />

    @using (Html.BeginForm("Resultados", "Vuelos", FormMethod.Get, new { data_validate_search = "true" }))
    {
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Aeropuerto de origen</label>
                @Html.DropDownList("Origen", null, "-- Todos los orígenes --", new { @class = "form-select", id = "Origen" })
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Aeropuerto de destino</label>
                @Html.DropDownList("Destino", null, "-- Todos los destinos --", new { @class = "form-select", id = "Destino" })
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha de salida</label>
                <input type="date" name="Fecha" id="Fecha" value="@ViewBag.fecha" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
            </div>

            <div class="col-md-1">
                <label class="form-label fw-bold">Pasajeros</label>
                <input type="number" name="Pasajeros" id="Pasajeros" value="@ViewBag.pasajeros" min="1" max="7" step="1" required="required" class="form-control" />
            </div>

            <div class="col-md-2 d-grid gap-2">
                <button type="submit" class="btn btn-gold">Buscar vuelos</button>
                <button type="submit" name="verTodos" value="true" class="btn btn-outline-secondary btn-sm">Ver todos</button>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card-aerolinea h-100">
            <h5>Rutas corporativas directas</h5>
            <p class="text-muted mb-0">Conectamos Quito (UIO), Guayaquil (GYE), Cuenca (CUE) y Manta (MEC) con salidas ejecutivas diarias.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-aerolinea h-100">
            <h5>Flota Embraer Phenom 300E</h5>
            <p class="text-muted mb-0">Cabina ejecutiva presurizada para 7 pasajeros con selección individual de asiento (1D a 4D).</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-aerolinea h-100">
            <h5>Tarifa transparente</h5>
            <p class="text-muted mb-0">Visualice el precio base, impuestos (IVA 15%) y la disponibilidad real de cada vuelo antes de reservar.</p>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
